    {
      "id": 9,
      "title": "站点运行概览",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "WITH refresh AS ( SELECT domain, domain_label, COUNT(*) AS active_asins, COUNT(*) FILTER (WHERE is_pending) AS pending_now, COUNT(*) FILTER (WHERE is_overdue) AS overdue_now, COUNT(*) FILTER (WHERE is_never_fetched) AS never_fetched FROM sync.keepa_refresh_status WHERE domain::text IN (${domain:singlequote}) GROUP BY domain, domain_label ), category_progress AS ( SELECT domain, COUNT(*) AS total_categories, COUNT(*) FILTER (WHERE bestseller_fetched_at IS NOT NULL) AS fetched_categories, COALESCE(SUM(COALESCE(bestseller_asin_count, 0)), 0) AS l1_seeded_asins FROM sync.keepa_category_registry WHERE depth = 1 AND domain::text IN (${domain:singlequote}) GROUP BY domain ), expansion_pool AS ( SELECT domain, COUNT(*) AS expansion_asins FROM sync.keepa_asin_registry WHERE is_active = TRUE AND discovery_source IN ('subcategory_bestseller', 'strategy_search') AND domain::text IN (${domain:singlequote}) GROUP BY domain ), snapshot_freshness AS ( SELECT domain, ROUND((EXTRACT(EPOCH FROM (CURRENT_TIMESTAMP - MAX(data_capture_time))) / 3600.0)::numeric, 1) AS snapshot_age_hours FROM sync.keepa_product_snapshot WHERE domain::text IN (${domain:singlequote}) GROUP BY domain ) SELECT r.domain_label AS \"站点\", r.active_asins AS \"活跃ASIN\", r.pending_now AS \"当前待采\", r.overdue_now AS \"已逾期\", r.never_fetched AS \"未首采\", COALESCE(c.l1_seeded_asins, 0) AS \"L1入池ASIN\", COALESCE(e.expansion_asins, 0) AS \"扩展ASIN\", COALESCE(c.fetched_categories, 0) AS \"已采类目\", COALESCE(c.total_categories, 0) AS \"总类目\", ROUND((100.0 * COALESCE(c.fetched_categories, 0) / GREATEST(COALESCE(c.total_categories, 0), 1))::numeric, 1) AS \"BestSeller覆盖%\", COALESCE(s.snapshot_age_hours, 0) AS \"快照滞后h\" FROM refresh r LEFT JOIN category_progress c ON r.domain = c.domain LEFT JOIN expansion_pool e ON r.domain = e.domain LEFT JOIN snapshot_freshness s ON r.domain = s.domain ORDER BY r.domain"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "当前待采",
            "desc": true
          }
        ]
      }
    },
