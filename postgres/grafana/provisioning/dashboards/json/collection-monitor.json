          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT finished_at AS \"时间\", CASE domain WHEN 1 THEN 'US' WHEN 2 THEN 'GB' WHEN 3 THEN 'DE' WHEN 4 THEN 'FR' WHEN 5 THEN 'JP' WHEN 6 THEN 'CA' WHEN 8 THEN 'IT' WHEN 9 THEN 'ES' WHEN 10 THEN 'IN' WHEN 11 THEN 'MX' WHEN 12 THEN 'BR' WHEN 13 THEN 'AU' ELSE domain::text END AS \"站点\", source AS \"来源\", LEFT(error_message, 180) AS \"错误\" FROM sync.collection_log WHERE COALESCE(error_message, '') <> '' AND domain::text IN (${domain:singlequote}) ORDER BY finished_at DESC LIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
