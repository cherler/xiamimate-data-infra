    {
      "id": 7,
      "title": "采集吞吐 (近 7 天, 5 分钟聚合)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', finished_at) + floor(date_part('minute', finished_at) / 5) * INTERVAL '5 minutes' AS time, SUM(asins_succeeded) AS asins_succeeded, SUM(rows_ingested) AS rows_ingested FROM sync.collection_log WHERE finished_at >= NOW() - INTERVAL '7 days' AND domain::text IN (${domain:singlequote}) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "drawStyle": "line",
          "fillOpacity": 10,
          "lineWidth": 2,
          "showPoints": "never"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
