      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((100.0 * COUNT(*) FILTER (WHERE has_offer_data) / GREATEST(COUNT(*), 1))::numeric, 1) AS offer_coverage_pct FROM sync.keepa_snapshot_status WHERE domain::text IN (${domain:singlequote})"
        }
      ],
      "fieldConfig": {
        "defaults": {
