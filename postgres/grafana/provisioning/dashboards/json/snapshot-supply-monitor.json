    {
      "id": 6,
      "title": "快照老化分布",
      "type": "barchart",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT * FROM (SELECT CASE WHEN snapshot_age_hours IS NULL THEN 'unknown' WHEN snapshot_age_hours < 6 THEN '<6h' WHEN snapshot_age_hours < 24 THEN '6-24h' WHEN snapshot_age_hours < 72 THEN '1-3d' ELSE '3d+' END AS bucket, COUNT(*) AS snapshot_count FROM sync.keepa_snapshot_status WHERE domain::text IN (${domain:singlequote}) GROUP BY 1) s ORDER BY CASE bucket WHEN '<6h' THEN 1 WHEN '6-24h' THEN 2 WHEN '1-3d' THEN 3 WHEN '3d+' THEN 4 ELSE 5 END"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "xField": "bucket"
      }
    },
    {
      "id": 7,
      "title": "当前总 Offer 分布",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT * FROM (SELECT CASE WHEN total_offer_count IS NULL THEN 'unknown' WHEN total_offer_count = 0 THEN '0' WHEN total_offer_count BETWEEN 1 AND 2 THEN '1-2' WHEN total_offer_count BETWEEN 3 AND 5 THEN '3-5' WHEN total_offer_count BETWEEN 6 AND 10 THEN '6-10' WHEN total_offer_count BETWEEN 11 AND 20 THEN '11-20' ELSE '21+' END AS bucket, COUNT(*) AS asin_count FROM sync.keepa_snapshot_status WHERE domain::text IN (${domain:singlequote}) GROUP BY 1) s ORDER BY CASE bucket WHEN '0' THEN 1 WHEN '1-2' THEN 2 WHEN '3-5' THEN 3 WHEN '6-10' THEN 4 WHEN '11-20' THEN 5 WHEN '21+' THEN 6 ELSE 7 END"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "xField": "bucket",
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "xField": "bucket"
      }
    },
    {
      "id": 8,
      "title": "各站点供给结构",
      "type": "table",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT domain_label AS \"站点\", COUNT(*) AS \"快照数\", ROUND(MIN(snapshot_age_hours)::numeric, 1) AS \"最新快照h\", ROUND(AVG(snapshot_age_hours)::numeric, 1) AS \"平均快照年龄h\", ROUND((100.0 * COUNT(*) FILTER (WHERE has_offer_data) / GREATEST(COUNT(*), 1))::numeric, 1) AS \"Offer覆盖%\", ROUND(AVG(total_offer_count)::numeric, 2) AS \"平均总Offer\", ROUND(AVG(offer_count_fba)::numeric, 2) AS \"平均FBA\", ROUND(AVG(offer_count_fbm)::numeric, 2) AS \"平均FBM\", ROUND(AVG(fba_share_pct)::numeric, 1) AS \"平均FBA占比%\" FROM sync.keepa_snapshot_status WHERE domain::text IN (${domain:singlequote}) GROUP BY domain, domain_label ORDER BY \"平均总Offer\" DESC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "title": "高供给 ASIN (Top 30)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT domain_label AS \"站点\", asin AS \"ASIN\", LEFT(COALESCE(product_title, ''), 80) AS \"标题\", total_offer_count AS \"总Offer\", offer_count_fba AS \"FBA\", offer_count_fbm AS \"FBM\", fba_share_pct AS \"FBA占比%\", price AS \"当前价格\", review_count AS \"评论数\", rating AS \"评分\", snapshot_age_hours AS \"快照年龄h\", offers_successful AS \"Offer明细成功\", data_capture_time AS \"抓取时间\" FROM sync.keepa_snapshot_status WHERE domain::text IN (${domain:singlequote}) ORDER BY total_offer_count DESC NULLS LAST, data_capture_time DESC LIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
