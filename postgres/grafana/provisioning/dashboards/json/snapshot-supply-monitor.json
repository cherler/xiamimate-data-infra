    {
      "id": 4,
      "title": "Offer 明细成功率",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((100.0 * COUNT(*) FILTER (WHERE offers_successful IS TRUE) / GREATEST(COUNT(*) FILTER (WHERE offers_successful IS NOT NULL), 1))::numeric, 1) AS offer_success_pct FROM sync.keepa_snapshot_status WHERE domain::text IN (${domain:singlequote})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
