          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(total_offer_count)::numeric, 2) AS avg_offer_count FROM sync.keepa_snapshot_status WHERE domain::text IN (${domain:singlequote}) AND total_offer_count IS NOT NULL"
