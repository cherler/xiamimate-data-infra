{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "活跃用户数",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS active_users FROM app.app_user WHERE status = 'active'"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2,
      "title": "全平台总余额",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(balance_points), 0) AS total_balance FROM app.user_credit_account"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 3,
      "title": "今日积分消费",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(ABS(points_delta)), 0) AS consumed_today FROM app.credit_ledger_entry WHERE entry_type = 'consume' AND (created_at AT TIME ZONE 'Asia/Shanghai')::date = (NOW() AT TIME ZONE 'Asia/Shanghai')::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "red", "value": 20000 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 4,
      "title": "今日充值/赠送",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(points_delta), 0) AS recharged_today FROM app.credit_ledger_entry WHERE entry_type IN ('recharge', 'signup_gift', 'admin_grant', 'subscription_grant') AND (created_at AT TIME ZONE 'Asia/Shanghai')::date = (NOW() AT TIME ZONE 'Asia/Shanghai')::date"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 5,
      "title": "今日交易笔数",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS tx_count FROM app.credit_ledger_entry WHERE (created_at AT TIME ZONE 'Asia/Shanghai')::date = (NOW() AT TIME ZONE 'Asia/Shanghai')::date"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 6,
      "title": "低余额用户",
      "description": "余额低于 100 积分的活跃用户数",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS low_balance_users FROM app.user_credit_account c JOIN app.app_user u ON u.user_id = c.user_id WHERE u.status = 'active' AND (c.balance_points - c.reserved_points) < 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 7,
      "title": "用户余额总览",
      "type": "table",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT u.display_name AS \"用户\", u.plan_tier AS \"套餐\", u.status AS \"状态\", c.balance_points AS \"余额积分\", c.reserved_points AS \"预扣积分\", (c.balance_points - c.reserved_points) AS \"可用余额\", c.lifetime_granted_points AS \"累计赠送\", c.lifetime_purchased_points AS \"累计充值\", c.lifetime_spent_points AS \"累计消费\", TO_CHAR(c.updated_at AT TIME ZONE 'Asia/Shanghai', 'YYYY-MM-DD HH24:MI:SS') AS \"更新时间\" FROM app.user_credit_account c JOIN app.app_user u ON u.user_id = c.user_id ORDER BY c.balance_points ASC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "可用余额" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 100 },
                    { "color": "green", "value": 500 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "可用余额", "desc": false }] }
    },
    {
      "id": 8,
      "title": "今日台账明细 (最近 50 笔)",
      "type": "table",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT TO_CHAR(e.created_at AT TIME ZONE 'Asia/Shanghai', 'HH24:MI:SS') AS \"时间\", u.display_name AS \"用户\", e.entry_type AS \"类型\", COALESCE(e.event_type, '-') AS \"事件\", e.units AS \"数量\", e.points_delta AS \"积分变动\", e.balance_after_points AS \"变动后余额\", COALESCE(e.description, '-') AS \"说明\" FROM app.credit_ledger_entry e JOIN app.app_user u ON u.user_id = e.user_id WHERE (e.created_at AT TIME ZONE 'Asia/Shanghai')::date = (NOW() AT TIME ZONE 'Asia/Shanghai')::date ORDER BY e.created_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "积分变动" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 0 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 9,
      "title": "每日积分消费与充值趋势",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT (date_trunc('day', created_at AT TIME ZONE 'Asia/Shanghai') AT TIME ZONE 'Asia/Shanghai') AS time, SUM(ABS(points_delta)) AS \"消费积分\" FROM app.credit_ledger_entry WHERE entry_type = 'consume' AND (created_at AT TIME ZONE 'Asia/Shanghai')::date >= ((NOW() AT TIME ZONE 'Asia/Shanghai')::date - INTERVAL '29 days') GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT (date_trunc('day', created_at AT TIME ZONE 'Asia/Shanghai') AT TIME ZONE 'Asia/Shanghai') AS time, SUM(points_delta) AS \"充值/赠送\" FROM app.credit_ledger_entry WHERE entry_type IN ('recharge', 'signup_gift', 'admin_grant', 'subscription_grant') AND (created_at AT TIME ZONE 'Asia/Shanghai')::date >= ((NOW() AT TIME ZONE 'Asia/Shanghai')::date - INTERVAL '29 days') GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "drawStyle": "bars",
          "fillOpacity": 60,
          "lineWidth": 1,
          "showPoints": "never"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "消费积分" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "充值/赠送" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10,
      "title": "每日交易笔数趋势",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT (date_trunc('day', created_at AT TIME ZONE 'Asia/Shanghai') AT TIME ZONE 'Asia/Shanghai') AS time, COUNT(*) FILTER (WHERE entry_type = 'consume') AS \"消费笔数\", COUNT(*) FILTER (WHERE entry_type IN ('recharge', 'signup_gift', 'admin_grant', 'subscription_grant')) AS \"充值笔数\" FROM app.credit_ledger_entry WHERE (created_at AT TIME ZONE 'Asia/Shanghai')::date >= ((NOW() AT TIME ZONE 'Asia/Shanghai')::date - INTERVAL '29 days') GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "drawStyle": "line",
          "fillOpacity": 20,
          "lineWidth": 2,
          "showPoints": "never"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "消费笔数" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "充值笔数" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "title": "按用户每日消费积分",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT (date_trunc('day', e.created_at AT TIME ZONE 'Asia/Shanghai') AT TIME ZONE 'Asia/Shanghai') AS time, u.display_name AS metric, SUM(ABS(e.points_delta)) AS points FROM app.credit_ledger_entry e JOIN app.app_user u ON u.user_id = e.user_id WHERE e.entry_type = 'consume' AND (e.created_at AT TIME ZONE 'Asia/Shanghai')::date >= ((NOW() AT TIME ZONE 'Asia/Shanghai')::date - INTERVAL '29 days') GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "drawStyle": "line",
          "fillOpacity": 20,
          "lineWidth": 2,
          "showPoints": "never"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "title": "消费事件类型分布 (近 7 天)",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(event_type, entry_type) AS event_type, SUM(ABS(points_delta)) AS points FROM app.credit_ledger_entry WHERE entry_type = 'consume' AND (created_at AT TIME ZONE 'Asia/Shanghai')::date >= ((NOW() AT TIME ZONE 'Asia/Shanghai')::date - INTERVAL '6 days') GROUP BY COALESCE(event_type, entry_type) ORDER BY points DESC"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "tooltip": { "mode": "single" } }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "xiamimate",
    "ops",
    "billing"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
