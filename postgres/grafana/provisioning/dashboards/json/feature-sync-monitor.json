        "name": "domain",
        "label": "站点 (Domain)",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "PostgreSQL" },
        "query": "SELECT domain::text AS __value, domain || '/' || CASE domain WHEN 1 THEN 'US' WHEN 2 THEN 'GB' WHEN 3 THEN 'DE' WHEN 4 THEN 'FR' WHEN 5 THEN 'JP' WHEN 6 THEN 'CA' WHEN 8 THEN 'IT' WHEN 9 THEN 'ES' WHEN 10 THEN 'IN' WHEN 11 THEN 'MX' WHEN 12 THEN 'BR' WHEN 13 THEN 'AU' END AS __text FROM serving.theme_base_daily GROUP BY domain ORDER BY domain",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
