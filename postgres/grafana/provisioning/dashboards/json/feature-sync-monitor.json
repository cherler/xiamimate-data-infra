    {
      "id": 5,
      "title": "最新 synced_at",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "PostgreSQL" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT MAX(synced_at) AS last_sync FROM serving.theme_base_daily WHERE domain::text IN (${domain:singlequote})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "dateTimeFromNow" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
